BOT_TOKEN=your_telegram_bot_token_here
MASTER_INDEX_CHANNEL_ID=-1001234567890

MINIAPP_URL=https://your-miniapp-domain.com
CORS_ALLOWED_ORIGINS=https://your-miniapp-domain.com
PUBLIC_API_BASE_URL=https://your-api-domain.com

WEBHOOK_SECRET=your_webhook_secret_here
JWT_SECRET=your_jwt_secret_here
TELEGRAM_WEBHOOK_URL=https://your-api-domain.com/webhook
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

PORT=3000
NODE_ENV=development
TRUST_PROXY=false

TMAIL_EMAIL_DOMAIN=tmailok.abrdns.com

JSON_BODY_LIMIT=256kb
API_TIMEOUT_MS=120000

TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
LOGIN_CODE_TTL_SECONDS=300
LOGIN_CODE_MAX_ATTEMPTS=5
LOGIN_CODE_RESEND_COOLDOWN_SECONDS=45
AUTH_CLEANUP_INTERVAL_SECONDS=60
MAX_PENDING_LOGIN_CHALLENGES=10000
SESSION_TTL_HOURS=720
MAX_SESSIONS_PER_USER=8

TELEGRAM_FORCE_IPV4=true
TELEGRAM_UPLOAD_FORCE_TLS12=true

MAX_ATTACHMENT_SIZE_MB=45
MAX_ATTACHMENTS_PER_EMAIL=10
MAX_TOTAL_ATTACHMENTS_SIZE_MB=45

MAX_RECIPIENTS_PER_EMAIL=50
MAX_SUBJECT_LENGTH=300
MAX_BODY_LENGTH=100000

OUTBOUND_EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here
RESEND_RECEIVING_API_URL=

INBOUND_EMAIL_WEBHOOK_SECRET=your_inbound_email_secret_here
MAX_INBOUND_EMAIL_RECIPIENTS=25
MAX_INBOUND_EMAIL_BODY_LENGTH=100000
MAX_INBOUND_ATTACHMENT_SIZE_MB=45
MAX_INBOUND_ATTACHMENTS_PER_EMAIL=10

ALLOW_DEV_AUTH_BYPASS=false
DEV_AUTH_BYPASS_LOCAL_ONLY=true
DEV_TELEGRAM_USER_ID=123456789
DEV_TELEGRAM_USERNAME=devuser
DEV_TELEGRAM_FIRST_NAME=Dev
DEV_TELEGRAM_LAST_NAME=User
