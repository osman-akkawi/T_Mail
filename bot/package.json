{
  "name": "tmail-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test:smoke": "npm run build && node scripts/user-flow-smoke-test.js",
    "test:api": "npm run build && node scripts/api-integration-test.js",
    "test:load": "npm run build && node scripts/thousand-user-load-test.js",
    "test:production": "npm run test:smoke && npm run test:api && npm run test:load",
    "test:api-server": "npm run build && node scripts/start-test-api-server.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "svix": "^1.95.1",
    "telegraf": "^4.16.3",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
